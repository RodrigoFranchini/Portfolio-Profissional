# Formulário de contato do site (client-side, exposto no bundle)
VITE_WEB3FORMS_ACCESS_KEY=sua_access_key_web3forms

# Servidor MCP (server-side). Habilita a tool `send_message`.
# Sem esta variável o servidor continua funcionando: send_message apenas
# devolve os canais diretos de contato em vez de entregar a mensagem.
WEB3FORMS_ACCESS_KEY=sua_access_key_web3forms

# URL pública do site, usada para montar links absolutos (currículo, imagens).
PORTFOLIO_SITE_URL=https://portifolio-profissional-virid.vercel.app
